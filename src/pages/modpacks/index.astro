---
import Navbar from "../../components/global/Navbar.astro";
import Footer from "../../components/global/Footer.astro";
import Hero from "../../components/modpacks/Hero.astro";

import CurrentModpack from "../../components/modpacks/CurrentModpack.astro";
import FeaturedModpacks from "../../components/modpacks/FeaturedModpacks.astro";

import { modpacks } from "../../data/modpacks";
import Layout from "../../layouts/Layout.astro";
---

<Layout sitetitle="Modpacks">
    <Navbar />
    <Hero />
    <main class="modpacks-page">
        <CurrentModpack modpacks={modpacks} />
        <FeaturedModpacks modpacks={modpacks} />
    </main>
    <Footer />
</Layout>

<style>
    .modpacks-page {
        min-height: 100vh;
        padding: 3rem 0;
        background: #130f0b;
    }
</style>
