---
import "../../styles/global.css";
---

<main class="hero">
    <section class="hero-content">
        <h1 class="hero-title"><span>MODPACKS</span></h1>
		<p class="text">
                Utforska Civitas alla modpacks genom tiderna – från stora, pågående projekt till gamla favoriter som inte sett dagens ljus sedan 2023!
        </p>
    </section>
</main>

<style>
    .hero {
        width: 100%;
        min-height: 240px;
        padding: 5rem 2rem 3rem;
        box-sizing: border-box;

        background-image: url("../../assets/home/hero_bg.webp");
        background-size:cover;
        background-position: center 45%;
        background-repeat: no-repeat;

        display: flex;
        align-items: center;
        justify-content: center;
    }

	.text {
        font-size: 1.25rem;

        font-family: var(--font-title);
        color: #fff;
        text-shadow: 1px 1px 8px #000000;
    }

    .hero-content {
        width: 100%;
        text-align: center;
    }

    .hero-title {
        margin: 0;

        user-select: none;
        font-size: clamp(3rem, 7vw, 6rem);
        line-height: 1.1;
        letter-spacing: clamp(0.1rem, 0.5vw, 0.5rem);
        font-family: var(--font-cobalt);

        filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.75));
    }

    .hero-title span {
        padding-right: 0.1em;

        background: linear-gradient(
            110deg,
            #f0a52c 0%,
            #ffe09a 50%,
            #f0a52c 100%
        );

        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
    }

    /* TABLET */
    @media (max-width: 1000px) {
        .hero {
            min-height: 210px;
            padding: 5rem 1.5rem 2rem;
        }

        .hero-title {
            font-size: clamp(3rem, 8vw, 5rem);
        }

		.text {
            font-size: 1.1rem;
        }
    }

    /* PHONE */
    @media (max-width: 600px) {
        .hero {
            min-height: 170px;
            padding: 5rem 1rem 1.5rem;
            background-position: 58% center;
        }

        .hero-title {
            font-size: clamp(2.5rem, 10vw, 3.5rem);
            letter-spacing: 0.1rem;
        }

		.text {
            font-size: 1rem;
        }
    }
</style>