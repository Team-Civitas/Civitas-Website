---
import "../../styles/global.css";

interface Props {
    href: string;
    title: string;
    text: string;
}

const { href, title, text } = Astro.props;
---

<a class="news-popup" href={href}>
    <p class="news-title">{title}</p>
    <p class="news-text">{text}</p>
</a>

<style>
    .news-popup {
        position: fixed;
        bottom: 16px;
        right: 16px;
        max-width: 300px;

        padding: 1rem;
        background: radial-gradient(
        ellipse at 50% 0%,
        #00000050 0%,
        #00000090 100%
    );

        border-radius: 10px;

		z-index: 1000;
        text-decoration: none;
        backdrop-filter: blur(50px);

        transition: 0.3s;
    }

    .news-popup:hover {
	background-color: #000;
}

    .news-title {
        margin: 0 0 1em;
        color: #f8d951;
        font-size: 20px;
        font-weight: normal;
    }

    .news-text {
        margin: 0 0 1em;
        color: #fff;
        font-size: 1rem;
        line-height: 1.5;
        font-weight: normal;
    }
</style>