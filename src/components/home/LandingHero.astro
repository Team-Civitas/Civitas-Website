---
import MainButton from "../ui/MainButton.astro";
import "../../styles/global.css";
---

<main class="hero">
	<section class="hero-content">
		<h1 class="hero-title">
			<span>CIVITAS</span>
		</h1>
		<MainButton href="/projects" text="Våra projekt ➜" />
	</section>
</main>

<style>
	.hero {
		width: 100%;
		min-height: 110vh;

		background-image: url("../../assets/home/hero_bg.webp");
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;

		display: flex;
		align-items: center;
		justify-content: center;

		padding: 0 1.5rem;
		box-sizing: border-box;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;

		transform: translateY(-5vh);
		text-align: center;
	}

	.hero-title {
		margin: 0;

		user-select: none;

		font-size: clamp(4rem, 17vw, 16rem);
		line-height: 0.9;

		letter-spacing: clamp(0.1rem, 0.5vw, 0.5rem);
		font-family: var(--font-cobalt);

		filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.75));
		transform: translateX(0.05em);

		white-space: nowrap;
	}

	.hero-title span {
		padding-right: 0.1em;

		background: linear-gradient(
			110deg,
			#f0a52c 0%,
			#ffe09a 50%,
			#f0a52c 100%
		);

		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
	}

	/*TABLET*/
	@media (max-width: 1000px) {
		.hero {
			min-height: 100vh;
		}

		.hero-content {
			gap: 1.5rem;
			transform: translateY(-3vh);
		}
	}

	/*PHONE*/
	@media (max-width: 600px) {
		.hero {
			min-height: 100svh;
        	background-position: -250px;

			padding: 0 1rem;
		}

		.hero-content {
			gap: 1.25rem;
			transform: translateY(-2vh);
		}

		.hero-title {
			font-size: clamp(3.5rem, 18vw, 6rem);
			letter-spacing: 0.1rem;
		}
	}
</style>
